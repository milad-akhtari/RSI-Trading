{
  "$defs": {
    "EventType": {
      "enum": [
        "ENTRY",
        "EXIT"
      ],
      "title": "EventType",
      "type": "string"
    },
    "Side": {
      "enum": [
        "LONG",
        "SHORT"
      ],
      "title": "Side",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "strategy": {
      "const": "RSI Trend Strategy",
      "title": "Strategy",
      "type": "string"
    },
    "instance_id": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Instance Id",
      "type": "string"
    },
    "event_id": {
      "maxLength": 400,
      "minLength": 8,
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "side": {
      "$ref": "#/$defs/Side"
    },
    "ticker": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Ticker",
      "type": "string"
    },
    "timeframe": {
      "title": "Timeframe",
      "type": "string"
    },
    "signal_time_ms": {
      "exclusiveMinimum": 0,
      "title": "Signal Time Ms",
      "type": "integer"
    },
    "signal_price": {
      "exclusiveMinimum": 0,
      "title": "Signal Price",
      "type": "number"
    },
    "structural_stop": {
      "exclusiveMinimum": 0,
      "title": "Structural Stop",
      "type": "number"
    },
    "planned_target": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Planned Target"
    },
    "rr": {
      "exclusiveMinimum": 0,
      "maximum": 10,
      "title": "Rr",
      "type": "number"
    },
    "risk_pct": {
      "exclusiveMinimum": 0,
      "maximum": 5,
      "title": "Risk Pct",
      "type": "number"
    },
    "rsi": {
      "maximum": 100,
      "minimum": 0,
      "title": "Rsi",
      "type": "number"
    },
    "market_state": {
      "enum": [
        "BULLISH",
        "BEARISH",
        "RANGE",
        "UNKNOWN"
      ],
      "title": "Market State",
      "type": "string"
    },
    "strength": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Strength",
      "type": "string"
    },
    "trade_id": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Trade Id",
      "type": "string"
    },
    "chart_tick_size": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chart Tick Size"
    }
  },
  "required": [
    "schema_version",
    "strategy",
    "instance_id",
    "event_id",
    "event_type",
    "side",
    "ticker",
    "timeframe",
    "signal_time_ms",
    "signal_price",
    "structural_stop",
    "rr",
    "risk_pct",
    "rsi",
    "market_state",
    "strength",
    "trade_id"
  ],
  "title": "WebhookEvent",
  "type": "object"
}
